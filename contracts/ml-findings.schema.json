{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tracefront:ml-findings:v1",
  "title": "TraceFront ML findings response v1",
  "description": "Model findings only. Shipment routes, recipients, lab results, message delivery, and approval state come from other services.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "analysis_id", "dataset_id", "generated_at", "model_version", "findings"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "analysis_id": { "type": "string", "minLength": 1 },
    "dataset_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "model_version": { "type": "string", "minLength": 1 },
    "checks": {
      "type": "array",
      "description": "Which checks had data to run. Zero findings from a check that covered no shipments is not a clearance.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "label", "fields", "shipments_checked", "shipments_total"],
        "properties": {
          "check": { "enum": ["temperature", "humidity", "delay", "quantity", "destination"] },
          "label": { "type": "string", "minLength": 1 },
          "fields": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "shipments_checked": { "type": "integer", "minimum": 0 },
          "shipments_total": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "batch_id", "shipment_id", "anomaly_type", "severity", "priority_score", "summary", "evidence"],
        "properties": {
          "finding_id": { "type": "string", "minLength": 1 },
          "batch_id": { "type": "string", "minLength": 1, "description": "Exact external batch ID from the supplier data." },
          "shipment_id": { "type": ["string", "null"], "description": "Exact external shipment ID, or null for a batch-level finding." },
          "anomaly_type": {
            "enum": ["temperature_excursion", "shipment_delay", "humidity_excursion", "quantity_mismatch", "sensor_gap", "destination_mismatch", "other"]
          },
          "severity": { "enum": ["low", "medium", "high", "unknown"] },
          "priority_score": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 100,
            "description": "Optional review priority, not a probability of contamination. Use null if no defensible scale exists."
          },
          "summary": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_record_id", "field", "observed_value"],
              "properties": {
                "source_record_id": { "type": "string", "minLength": 1 },
                "field": { "type": "string", "minLength": 1 },
                "observed_value": { "type": ["number", "string"] },
                "threshold_value": { "type": ["number", "null"] },
                "unit": { "type": ["string", "null"] },
                "observed_at": { "type": ["string", "null"], "format": "date-time" }
              }
            }
          }
        }
      }
    }
  }
}
